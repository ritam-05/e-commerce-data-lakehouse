table fact_orders
	lineageTag: 22c8064a-d7d2-4ab2-8194-cfca5beb61f3

	measure 'Total Orders' = DISTINCTCOUNT(fact_orders[order_id])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: a8c31a04-79a5-44bc-b4ae-8af58052d69e

	measure 'Average Order Value' = [Total Revenue] / [Total Orders]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c425afd0-f16b-4695-8b3f-d3bf352f6abd

	measure 'Delivery Time (Days)' = AVERAGEX(fact_orders, DATEDIFF(fact_orders[order_approved_at], fact_orders[order_delivered_customer_date], DAY))
		formatString: 0.00
		lineageTag: 80a61218-5137-48a9-ab7c-0292f9197c1c
		dataCategory: Uncategorized

